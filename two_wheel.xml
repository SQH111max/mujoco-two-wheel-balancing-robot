<mujoco model="two_wheel_balance">
  <!-- angle 设置 XML 的角度单位。inertiagrouprange 指定用第 0 组几何推算质量和惯量。 -->
  <compiler angle="degree" inertiagrouprange="0 0"/>
  <!-- MuJoCo 使用 implicitfast 积分器，每步推进 0.005 秒。重力沿世界坐标的 -z 方向。 -->
  <option timestep="0.005" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <headlight ambient="0.38 0.38 0.40" diffuse="0.46 0.46 0.44" specular="0.15 0.15 0.15"/>
    <quality numslices="48" numstacks="28"/>
  </visual>

  <!-- 第 1 组是外观。零质量和零碰撞掩码让接地和惯量计算都使用物理层的几何。 -->
  <default>
    <default class="decoration">
      <geom group="1" contype="0" conaffinity="0" mass="0"/>
    </default>
  </default>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient" width="256" height="256"
             rgb1="0.19 0.27 0.33" rgb2="0.06 0.09 0.12"/>
    <texture name="floor_grid" type="2d" builtin="checker" width="128" height="128"
             rgb1="0.22 0.28 0.31" rgb2="0.27 0.33 0.36"/>
    <material name="floor_material" texture="floor_grid" texrepeat="4 4" texuniform="true"
              specular="0.12"/>
    <material name="duck_yellow" rgba="1 0.73 0.045 1" specular="0.32" shininess="0.38"/>
    <material name="wing_yellow" rgba="0.98 0.63 0.035 1" specular="0.20"/>
    <material name="beak_orange" rgba="1 0.33 0.035 1" specular="0.30" shininess="0.38"/>
    <material name="tire_rubber" rgba="0.07 0.09 0.11 1" specular="0.12"/>
  </asset>

  <worldbody>
    <light name="key_light" pos="0.5 -0.7 1.2" dir="-0.32 0.42 -0.85" directional="true"
           diffuse="0.43 0.40 0.37" specular="0.25 0.24 0.21"/>
    <!-- 地面高度为 0。摩擦让转动的车轮能够带动车身。 -->
    <geom name="floor" type="plane" size="2 2 0.1" material="floor_material"
          friction="1 0.005 0.0001"/>

    <!-- 车身坐标的 x 向前、y 向左、z 向上。车身原点在两轮轮轴的中点。 -->
    <body name="chassis" pos="0 0 0.06">
      <!-- 车身可自由移动和转动，由轮子与地面的接触支撑。 -->
      <freejoint name="base_joint"/>
      <!-- 透明车身盒负责碰撞和惯量。鸭身外壳是跟随车身的装饰几何。 -->
      <geom name="body_box" type="box" pos="0 0 0.11" size="0.042 0.075 0.082"
            mass="1.2" rgba="0 0 0 0"/>
      <geom class="decoration" name="wheel_base" type="ellipsoid"
            pos="-0.014 0 0.037" size="0.074 0.078 0.023" material="tire_rubber"/>
      <geom class="decoration" name="duck_body" type="ellipsoid"
            pos="-0.022 0 0.096" size="0.103 0.073 0.063" material="duck_yellow"/>
      <geom class="decoration" name="tail" type="ellipsoid" euler="0 28 0"
            pos="-0.110 0 0.120" size="0.047 0.035 0.023" material="duck_yellow"/>
      <geom class="decoration" name="left_wing" type="ellipsoid" euler="0 -10 0"
            pos="-0.038 0.061 0.102" size="0.063 0.015 0.030" material="wing_yellow"/>
      <geom class="decoration" name="right_wing" type="ellipsoid" euler="0 -10 0"
            pos="-0.038 -0.061 0.102" size="0.063 0.015 0.030" material="wing_yellow"/>

      <!-- 鸭嘴指向车身的 +x，眼睛朝前外侧，便于辨认车头和转向。 -->
      <geom class="decoration" name="duck_head" type="sphere"
            pos="0.051 0 0.181" size="0.059" material="duck_yellow"/>
      <geom class="decoration" name="lower_beak" type="ellipsoid"
            pos="0.123 0 0.148" size="0.033 0.028 0.009" rgba="0.85 0.23 0.028 1"/>
      <geom class="decoration" name="upper_beak" type="ellipsoid"
            pos="0.128 0 0.161" size="0.041 0.035 0.014" material="beak_orange"/>
      <geom class="decoration" type="ellipsoid" pos="0.128 0.013 0.1735"
            size="0.0045 0.0027 0.0017" rgba="0.49 0.14 0.023 1"/>
      <geom class="decoration" type="ellipsoid" pos="0.128 -0.013 0.1735"
            size="0.0045 0.0027 0.0017" rgba="0.49 0.14 0.023 1"/>

      <geom class="decoration" type="ellipsoid" pos="0.081 0.041 0.203" euler="0 0 -30"
            size="0.017 0.010 0.019" rgba="1 0.98 0.91 1"/>
      <geom class="decoration" type="ellipsoid" pos="0.081 -0.041 0.203" euler="0 0 30"
            size="0.017 0.010 0.019" rgba="1 0.98 0.91 1"/>
      <geom class="decoration" type="ellipsoid" pos="0.087 0.046 0.205" euler="0 0 -30"
            size="0.011 0.0054 0.013" rgba="0.042 0.034 0.027 1"/>
      <geom class="decoration" type="ellipsoid" pos="0.087 -0.046 0.205" euler="0 0 30"
            size="0.011 0.0054 0.013" rgba="0.042 0.034 0.027 1"/>
      <geom class="decoration" type="sphere" pos="0.089 0.050 0.211"
            size="0.0032" rgba="1 1 1 1"/>
      <geom class="decoration" type="sphere" pos="0.089 -0.050 0.211"
            size="0.0032" rgba="1 1 1 1"/>

      <!-- 左右轮半径都是 0.06 m，绕平行于车身 +y 的轴转动。 -->
      <body name="left_wheel" pos="0 0.095 0">
        <joint name="left_axle" type="hinge" axis="0 1 0"/>
        <geom name="left_contact" type="cylinder" size="0.06 0.014" euler="90 0 0"
              mass="0.08" rgba="0 0 0 0"/>
        <geom class="decoration" type="cylinder" size="0.06 0.014" euler="90 0 0"
              material="tire_rubber"/>
        <geom class="decoration" type="cylinder" pos="0 0.014 0" size="0.043 0.0023"
              euler="90 0 0" rgba="0.11 0.66 0.52 1"/>
        <geom class="decoration" type="cylinder" pos="0 0.016 0" size="0.029 0.0020"
              euler="90 0 0" rgba="0.22 0.31 0.32 1"/>
        <geom class="decoration" type="cylinder" pos="0 0.018 0" size="0.012 0.0020"
              euler="90 0 0" rgba="0.78 0.82 0.79 1"/>
        <site pos="0.036 0.017 0" size="0.0045" rgba="1 1 1 1"/>
      </body>
      <body name="right_wheel" pos="0 -0.095 0">
        <joint name="right_axle" type="hinge" axis="0 1 0"/>
        <geom name="right_contact" type="cylinder" size="0.06 0.014" euler="90 0 0"
              mass="0.08" rgba="0 0 0 0"/>
        <geom class="decoration" type="cylinder" size="0.06 0.014" euler="90 0 0"
              material="tire_rubber"/>
        <geom class="decoration" type="cylinder" pos="0 -0.014 0" size="0.043 0.0023"
              euler="90 0 0" rgba="0.96 0.38 0.11 1"/>
        <geom class="decoration" type="cylinder" pos="0 -0.016 0" size="0.029 0.0020"
              euler="90 0 0" rgba="0.31 0.26 0.24 1"/>
        <geom class="decoration" type="cylinder" pos="0 -0.018 0" size="0.012 0.0020"
              euler="90 0 0" rgba="0.78 0.82 0.79 1"/>
        <site pos="0.036 -0.017 0" size="0.0045" rgba="1 1 1 1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- 每个电机作用于对应的铰链。gear=1 时输入数值直接对应关节扭矩（N·m）。 -->
    <!-- ctrllimited 启用输入限幅。ctrlrange 给出每个电机的扭矩上下限。 -->
    <motor name="left_motor" joint="left_axle" gear="1" ctrllimited="true" ctrlrange="-0.5 0.5"/>
    <motor name="right_motor" joint="right_axle" gear="1" ctrllimited="true" ctrlrange="-0.5 0.5"/>
  </actuator>
</mujoco>
